+/**
+ * Android installs a seccomp filter on every app process.  That filter is
+ * evaluated before -- and takes precedence over -- the filter PRoot installs
+ * later for its ptrace acceleration, so a syscall the platform refuses (on
+ * arm64: setregid, syscall 143, called by zygote during class preloading)
+ * raises SIGSYS with si_code == SYS_SECCOMP even though PRoot would have
+ * emulated it happily.  The kernel already skipped the syscall and left the
+ * PC after it, so fabricate a result and swallow the signal instead of
+ * letting it kill the tracee.
+ *
+ * Credential-changing calls must report success under PRoot's fake root;
+ * everything else reports -ENOSYS so the caller uses its fallback path.
+ *
+ * Returns the signal to deliver: 0 when handled, SIGSYS otherwise.
+ */
+static int handle_seccomp_trap(Tracee *tracee)
+{
+    static const Sysnum setid_sysnums[] = {
+	PR_setregid, PR_setgid, PR_setreuid, PR_setuid,
+	PR_setresuid, PR_setresgid, PR_setfsuid, PR_setfsgid,
+	PR_setgroups,
+    };
+    siginfo_t siginfo;
+    word_t result;
+    long status;
+    size_t i;
+
+    memset(&siginfo, 0, sizeof(siginfo));
+    status = ptrace(PTRACE_GETSIGINFO, tracee->pid, NULL, &siginfo);
+    if (status < 0 || siginfo.si_code != SYS_SECCOMP)
+	return SIGSYS;
+
+    result = (word_t) -ENOSYS;
+    for (i = 0; i < sizeof(setid_sysnums) / sizeof(setid_sysnums[0]); i++) {
+	if ((word_t) siginfo.si_syscall ==
+	    detranslate_sysnum(get_abi(tracee), setid_sysnums[i])) {
+	    result = 0;
+	    break;
+	}
+    }
+
+    status = fetch_regs(tracee);
+    if (status < 0)
+	return SIGSYS;
+
+    /* Not inside a syscall: keep the cached register banks in sync so
+     * only the result register is written back by push_regs().  */
+    save_current_regs(tracee, ORIGINAL);
+    tracee->restore_original_regs = false;
+    poke_reg(tracee, SYSARG_RESULT, result);
+
+    status = push_regs(tracee);
+    if (status < 0)
+	return SIGSYS;
+
+    VERBOSE(tracee, 1,
+	    "vpid %" PRIu64 ": seccomp trap for syscall %d answered with %ld",
+	    tracee->vpid, siginfo.si_syscall, (long) result);
+
+    /* Continue at the instruction after the skipped syscall.  */
+    tracee->restart_how = PTRACE_CONT;
+    tracee->sysexit_pending = false;
+    return 0;
+}
+
 /**
