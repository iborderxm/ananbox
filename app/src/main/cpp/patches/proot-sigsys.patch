@@ -611,6 +686,10 @@ static int handle_tracee_event_kernel_4_8(Tracee *tracee,
 	    }
 	    break;
 
+	case SIGSYS:
+	    signal = handle_seccomp_trap(tracee);
+	    break;
+
 	default:
 	    /* Deliver this signal as-is.  */
 	    break;
@@ -843,6 +922,10 @@ int handle_tracee_event(Tracee *tracee, int tracee_status)
 	    }
 	    break;
 
+	case SIGSYS:
