include(ExternalProject)
include(Talloc)
include(Unwind)
set(PROOT_SRC ${CMAKE_CURRENT_BINARY_DIR}/proot-prefix/src/proot/src)
set(PROOT_BIN ${CMAKE_CURRENT_BINARY_DIR}/proot-prefix/src/proot-build)
set(PROOT_C_FLAGS "-I${TALLOC_INCLUDE_DIRS} -I${PROOT_SRC} -D_GNU_SOURCE -I${UNWIND_INCLUDE_DIRS}")
set(PROOT_LINKER_FLAGS "-L${TALLOC_BIN}/lib -L${CMAKE_BINARY_DIR} -ltalloc -lunwind_ptrace")
# PRoot >= 5.5.0 aborts while *parsing* src/GNUmakefile when pkg-config
# cannot find talloc.pc (GNUmakefile:52 -> $(error ...)), so every make
# invocation inside the proot source tree needs PKG_CONFIG_PATH -- not just
# the build step, the plain "make clean" configure step as well.
set(PROOT_PKG_CONFIG_PATH PKG_CONFIG_PATH=${TALLOC_PKGCONFIG_DIR})
# specific correct clang target to use
if(${CMAKE_ANDROID_ARCH_ABI} STREQUAL "arm64-v8a")
    set(PROOT_C_COMPILER ${ANDROID_TOOLCHAIN_ROOT}/bin/aarch64-linux-android${CMAKE_SYSTEM_VERSION}-clang)
else()
    set(PROOT_C_COMPILER ${ANDROID_TOOLCHAIN_ROOT}/bin/${CMAKE_ANDROID_ARCH_ABI}-linux-android${CMAKE_SYSTEM_VERSION}-clang)
endif()
ExternalProject_Add(
        proot
        GIT_REPOSITORY https://github.com/proot-me/proot.git
        GIT_TAG 25dc6a3134891f98a79f57ce1c2c1b23ff15cad1
        GIT_SHALLOW 1
        # PRoot >= 5.5.0 needs lib/uthash (a git submodule) for
        # src/extension/care/care.c. Without it the build fails on the
        # missing uthash.h.
        GIT_SUBMODULES_RECURSE ON
        # NOTE: ExternalProject accepts only ONE PATCH_COMMAND.  A second one
        # is merged into the first as an extra argument of "sh -c" and is
        # silently dropped -- the second patch would then never be applied
        # while the build still succeeds.  Both patches are applied by a
        # single helper script instead.
        #
        # The script applies:
        #  - proot-sigsys.patch: handle the SIGSYS raised by the seccomp
        #    filter the Android host installs on app processes, otherwise
        #    the guest zygote dies on setregid and init restarts it forever;
        #  - proot-android-adapt.patch: transplant the Android-specific
        #    commits that Ananbox/proot carries on top of upstream (capability
        #    emulation, PR_CAPBSET_DROP and unshare(2) bypasses, mount --bind
        #    through the binding mechanism).  Upstream v5.5.0 has none of them,
        #    so the guest zygote dies on "capset failed".
        #
        # Each patch is guarded by a grep for a token that only exists once
        # that patch has been applied, so the script is idempotent.
        PATCH_COMMAND sh ${CMAKE_SOURCE_DIR}/patches/apply-proot-patches.sh ${CMAKE_SOURCE_DIR}/patches
        CONFIGURE_COMMAND cd ${PROOT_SRC} && ${PROOT_PKG_CONFIG_PATH} make clean
        # HAS_SWIG/HAS_PYTHON_CONFIG are cleared on purpose: when a host swig and
        # python3-config are present (e.g. CI runners) proot tries to build its
        # Python extension with host includes and breaks the cross build.
        # PKG_CONFIG_PATH points at the talloc.pc generated by Talloc.cmake:
        # since 5.5.0 the build aborts with $(error ...) when pkg-config
        # cannot locate talloc.pc.
        BUILD_COMMAND cd ${PROOT_SRC} && ${PROOT_PKG_CONFIG_PATH} make V=1 HAS_SWIG= HAS_PYTHON_CONFIG= CC=${PROOT_C_COMPILER} LD=${PROOT_C_COMPILER} STRIP=${CMAKE_STRIP} OBJCOPY=${CMAKE_OBJCOPY} OBJDUMP=${CMAKE_OBJDUMP} CFLAGS=${PROOT_C_FLAGS} LDFLAGS=${PROOT_LINKER_FLAGS}
        # hacked: only lib*.so can be packed into apk
        INSTALL_COMMAND cd ${PROOT_SRC} && cp -f ./proot ${CMAKE_LIBRARY_OUTPUT_DIRECTORY}/libproot.so
        DEPENDS talloc unwind_ptrace
)
